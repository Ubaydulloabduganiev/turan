{
  "name": "turkistan-silk-road",
  "productName": "Turkistan - Silk Road Khanates",
  "version": "0.1.0",
  "description": "A real-time strategy and city-building game set on the Silk Road.",
  "main": "main.js",
  "author": "Ilhomjon",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.turkistan.silkroad",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Turkistan"
    }
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  }
}
